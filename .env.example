# News Tracker Bot Environment Variables
# Copy this file to .env and fill in your actual values

# Telegram Bot Token
# Get this from @BotFather on Telegram
SHABDA_TELE_KEY=

# News API Key
# Get this from https://newsapi.org/
NEWS_API_KEY=

# MongoDB Connection URI
# For Docker setup (default - no authentication):
MONGO_URI=mongodb://localhost:27017/news_db
# For authenticated MongoDB:
#MONGO_URI=mongodb://news_user:news_password@localhost:27017/news_db?authSource=news_db

# Text-to-Speech Engine Preference
# Options: 'edge' (best quality), 'gtts' (good quality), 'pyttsx3' (offline)
TTS_ENGINE=edge

# Application Settings
LOG_LEVEL=INFO
LOG_DIR=logs
AUDIO_DIR=data/audio
REFRESH_INTERVAL_HOURS=12
